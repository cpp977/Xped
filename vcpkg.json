{
    "name": "xped",
    "version": "0.4.0",
    "dependencies": [
        "seq",
        "eigen3",
        "spdlog",
        "tabulate",
        "yas",
        "highfive",
        "lru-cache",
        "boost-rational",
        "boost-algorithm",
        "boost-functional",
        "boost-math",
        "boost-iterator",
        "boost-predef",
        "boost-describe",
        "wignersun",
        "doctest",
        "toml11",
        "libassert",
        "nlohmann-json"
    ],
    "default-features": [ "eigen" ],
    "features": {
        "eigen": {
            "description": "Tensor operations with Eigen backend."
        },
        "ctf": {
            "description": "Tensor operations with cyclops backend.",
            "dependencies": [
                "ctf",
                "scalapack"
            ]
        },
        "array": {
            "description": "Tensor operations with array backend.",
            "dependencies": [
                "array"
            ]
        },
        "external-stan": {
            "description": "Use the external stan-math library for AD instead of the bundled self-contained engine (requires -DXPED_USE_EXTERNAL_STAN=ON).",
            "dependencies": [
                "stan-math"
            ]
        },
        "external-ceres": {
            "description": "Use the external ceres-solver instead of the bundled self-contained L-BFGS engine (requires -DXPED_USE_EXTERNAL_CERES=ON).",
            "dependencies": [
                "ceres"
            ]
        },
        "gsl-coeffs": {
            "description": "Use GSL for SU(2) coupling coefficients instead of the bundled self-contained implementation (requires -DXPED_USE_GSL_COEFFS=ON).",
            "dependencies": [
                "gsl"
            ]
        }
    }
}
